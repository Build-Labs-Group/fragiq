// FragIQ — schema.
// Modelo central: séries temporais de estatísticas por (usuário, jogo).
// Os contadores da Steam Web API são cumulativos e vitalícios; guardamos
// snapshots periódicos e derivamos a performance de um período pelo delta
// entre dois snapshots. Isso é o que permite "acompanhar ao longo do tempo".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  // SteamID64 — identificador externo estável. O personaName muda, este não.
  steamId     String  @unique
  personaName String
  avatarUrl   String?
  profileUrl  String?
  countryCode String?

  /// A página pública em /p/<steamId>. Mostra só o que a Steam já mostra a
  /// qualquer um. Desligar esconde a página inteira.
  perfilPublico Boolean @default(true)

  /// Se quem te segue vê a sua curva (a série, as sessões, os cartões).
  ///
  /// Substitui a aprovação pedido a pedido: como seguir passou a ser
  /// unilateral, a escolha de mostrar a evolução precisa existir em algum
  /// lugar, e uma decisão que vale para todo mundo é a que se consegue
  /// manter. Desligado, seguidores veem o mesmo que qualquer um vê.
  curvaVisivel Boolean @default(true)

  /// Receber a análise de cada sessão no chat da Steam, pelo bot. Só chega
  /// para quem adicionou o bot; desligar aqui silencia mesmo sendo amigo.
  avisoSteam         Boolean   @default(true)
  /// O último lembrete, no chat, de que a Steam não deixa ler as
  /// estatísticas ("Detalhes do jogo" privado), e quantos já foram. O bot
  /// insiste de tempos em tempos (`lembrarPendenciasNoSteam`), com teto.
  avisoPrivacidadeEm DateTime?
  avisosPrivacidade  Int       @default(0)
  /// O último lembrete de que a corrente de share codes está desligada —
  /// sem ela não há partida oficial nem modo por partida — e quantos já
  /// foram. Mesma cadência e mesmo teto.
  avisoPartidasEm    DateTime?
  avisosPartidas     Int       @default(0)
  /// Desde quando o bot de presença é amigo (o bot reporta a lista). null =
  /// não é. É o que o funil de ativação lê sem perguntar à Steam.
  botAmigoDesde      DateTime?

  /// Código de autenticação do histórico de partidas (a Steam chama de
  /// "match history authentication code"). Só serve para pedir o próximo
  /// share code à Web API — não abre inventário, chat nem nada da conta.
  /// Guardado cifrado; a pessoa revoga na página de segurança ou gerando
  /// outro na Steam.
  steamAuthCode      String?
  /// O share code mais recente que conhecemos: é de onde a próxima busca
  /// continua. A Steam só responde "qual é o seguinte a este".
  shareCodeAtual     String?
  /// Último erro ao falar com a Steam sobre partidas, para a página dizer
  /// o que fazer (código inválido, share code expirado...).
  partidasErro       String?
  partidasAtivadasEm DateTime?

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  partidas    MatchPlayer[]
  sessoes     Session[]
  insights    Insight[]
  inventario  InventoryItem[]

  /// Inventário: se a última leitura o achou público, e quando foi.
  inventarioPublico   Boolean?
  inventarioLidoEm    DateTime?
  capturas    PendingCapture[]
  games       UserGame[]
  syncRuns    SyncRun[]
  feedback    Feedback[]
  analyses    Analysis[]
  participant Participant?
  seguindo    Follow[]        @relation("seguidor")
  seguidores  Follow[]        @relation("seguido")
  mensagens   SteamMessage[]

  @@map("users")
}

model Game {
  // appId da Steam (730 = CS2). Chave natural, usada nas URLs.
  appId Int    @id
  name  String

  iconHash String?

  // Schema de stats vindo de ISteamUserStats/GetSchemaForGame: mapeia
  // nomes crus ("total_kills") para rótulos legíveis. Cacheado por jogo,
  // não por usuário.
  statSchema      Json?
  schemaFetchedAt DateTime?

  // false quando o jogo não expõe stats públicas — evita refetch a cada sync.
  supportsStats Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players UserGame[]

  @@map("games")
}

model UserGame {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameAppId Int
  game      Game @relation(fields: [gameAppId], references: [appId], onDelete: Cascade)

  playtimeForeverMin  Int       @default(0)
  playtimeTwoWeeksMin Int       @default(0)
  lastPlayedAt        DateTime?

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots StatSnapshot[]

  @@unique([userId, gameAppId])
  @@index([userId, playtimeForeverMin])
  @@map("user_games")
}

model StatSnapshot {
  id String @id @default(cuid())

  userGameId String
  userGame   UserGame @relation(fields: [userGameId], references: [id], onDelete: Cascade)

  capturedAt DateTime @default(now())

  // Tempo de jogo no instante do snapshot — permite normalizar deltas por hora.
  playtimeForeverMin Int @default(0)

  // Stats cruas do jogo: { "total_kills": 41234, "total_deaths": 39001, ... }
  // Json porque cada appId tem um conjunto de stats totalmente diferente.
  metrics Json

  achievementsUnlocked Int?
  achievementsTotal    Int?

  /// Contexto da partida que produziu o delta até este snapshot, quando o bot
  /// de presença conseguiu observá-la.
  ///
  /// A API de estatísticas não distingue modo nem cobre os mapas modernos,
  /// mas o rich presence do CS2 publica os dois para amigos. Guardando aqui,
  /// o delta entre o snapshot anterior e este passa a ser atribuível a um
  /// mapa e a um modo — o que a Web API sozinha não permite.
  matchMap   String?
  matchMode  String?
  matchScore String?

  /// Proveniência: a coleta que criou este ponto, o gatilho dela e o
  /// `traceId` que amarra bot → captura → coleta → ponto. Nulo no histórico
  /// anterior a 2026-09-16 (docs/dados-confiaveis.md §3.1).
  syncRunId String?
  syncRun   SyncRun?     @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  trigger   SyncTrigger?
  traceId   String?

  analyses Analysis[]

  @@unique([userGameId, capturedAt])
  @@index([userGameId, capturedAt])
  @@index([userGameId, matchMode])
  @@index([traceId])
  @@map("stat_snapshots")
}

/// Feedback do beta. Só de usuário autenticado, então cada mensagem já vem
/// amarrada ao SteamID — dá para ler o relato e olhar a série da pessoa lado
/// a lado, que é o que torna o feedback acionável.
model Feedback {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String

  /// De onde a pessoa enviou. "Está confuso" significa coisas diferentes no
  /// dashboard e no explorador.
  path String?

  /// A pessoa escolheu que este relato apareça na página da comunidade, com
  /// o nome dela. Padrão privado: feedback é confissão até se dizer o
  /// contrário.
  publico Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("feedback")
}

/// Uma linha por invocação do coletor agendado, mesmo quando não há nada a
/// fazer.
///
/// O SyncRun é por usuário e só nasce dentro de syncUser — então uma execução
/// que não encontra candidatos não deixa rastro nenhum. Isso torna
/// indistinguível "o agendador não disparou" de "disparou e não havia o que
/// coletar", e a diferença importa: dado perdido por cron parado não é
/// recuperável, porque a Steam só sabe o total de hoje.
model CronRun {
  id String @id @default(cuid())

  status SyncStatus @default(RUNNING)

  candidates Int @default(0)
  synced     Int @default(0)
  failed     Int @default(0)
  skipped    Int @default(0)
  snapshots  Int @default(0)

  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
  @@map("cron_runs")
}

model SyncRun {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trigger     SyncTrigger @default(MANUAL)
  status      SyncStatus  @default(RUNNING)
  gamesSeen   Int         @default(0)
  gamesStored Int         @default(0)
  error       String?
  /// Vem do bot (evento) ou nasce aqui (cron, manual, login). É o fio da auditoria.
  traceId     String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  snapshots StatSnapshot[]

  @@index([userId, startedAt])
  @@index([traceId])
  @@map("sync_runs")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// De onde partiu a coleta. Útil para saber se a série de um usuário vem do
/// cron (contínua) ou só de cliques manuais (esburacada).
enum SyncTrigger {
  MANUAL
  LOGIN
  CRON
  /// Disparado pelo bot de presença quando o jogador sai de uma partida.
  EVENT
}

/// Uma pergunta feita ao analista sobre um jogo, e a resposta quando chega.
///
/// O analista é um agente do cogniflow, e a conversa com ele é assíncrona:
/// a pergunta sai por webhook, a resposta volta por callback segundos
/// depois. A linha existe para que a tela tenha o que mostrar nesse meio
/// tempo e para que a resposta tenha onde pousar quando o request que
/// perguntou já acabou.
model Analysis {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameAppId Int

  question String
  answer   String?

  /// Uma análise chega sozinha a cada sessão nova (SESSION) ou porque a
  /// pessoa perguntou (QUESTION). A primeira é o produto; a segunda, o
  /// acompanhamento.
  kind AnalysisKind @default(QUESTION)

  /// A coleta que fechou a sessão analisada. Única: uma sessão, uma análise —
  /// é o que impede o cron, o bot e a página de pedirem a mesma três vezes.
  snapshotId String?       @unique
  snapshot   StatSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  status AnalysisStatus @default(PENDING)
  error  String?

  /// ID da resposta no cogniflow. É determinístico por turno: uma entrega
  /// repetida chega com o mesmo ID, e é assim que a repetição é descartada.
  replyId String? @unique

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  answeredAt     DateTime?

  @@index([userId, gameAppId, createdAt])
  @@map("analyses")
}

enum AnalysisKind {
  SESSION
  QUESTION
}

enum AnalysisStatus {
  /// Enviada ao cogniflow; nenhuma confirmação ainda.
  PENDING
  /// O cogniflow confirmou o recebimento e está respondendo.
  ACKNOWLEDGED
  ANSWERED
  FAILED
}

/// Quem escolheu fazer parte do desenvolvimento.
///
/// Uma linha por usuário. Existir aqui é o que dá o selo de beta tester; o
/// GitHub é para quem quer código, e a mensagem é o que a pessoa disse que
/// quer fazer. `visivel` decide se aparece na lista pública.
model Participant {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubLogin String?
  /// O que a pessoa se dispôs a fazer: testar, desenvolver, trazer dados…
  papeis      String[]
  mensagem    String?

  visivel Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("participants")
}

/// Ver a curva de outra pessoa exige que ela deixe.
///
/// Os números vitalícios são públicos na Steam; a série de coletas, as
/// sessões e as leituras não são públicas em lugar nenhum. Então "seguir" é
/// um pedido: fica PENDING até quem é seguido aceitar, e só a partir daí a
/// página pública dessa pessoa mostra a curva para quem pediu.
/// Quem segue quem. Um fato só, sem estado.
///
/// Era um pedido que o outro lado aceitava ou recusava, e o que a
/// aprovação de fato controlava não era o seguir — era ver a curva. Duas
/// coisas num gesto só: quem queria acompanhar alguém tinha que pedir
/// autorização, e quem queria manter a curva fechada tinha que recusar
/// pessoa por pessoa, para sempre.
///
/// Separadas: seguir é unilateral e imediato, como em qualquer outro
/// lugar; quem vê a curva é decidido de uma vez por `User.curvaVisivel`.
model Follow {
  id String @id @default(cuid())

  seguidorId String
  seguidor   User   @relation("seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)

  seguidoId String
  seguido   User   @relation("seguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([seguidorId, seguidoId])
  @@index([seguidoId])
  @@map("follows")
}

/// Uma mensagem para o bot entregar no chat da Steam.
///
/// O bot não recebe chamadas: ele mora numa EC2 sem porta aberta e só faz
/// saída. Então o site enfileira aqui e o bot busca de tempos em tempos,
/// entrega e marca. Uma linha por mensagem, com o resultado da entrega —
/// é o que permite ver no painel o que chegou e o que não chegou.
model SteamMessage {
  id String @id @default(cuid())

  /// Nulo para quem o bot alcança mas ainda não tem conta (convite).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  steamId String
  texto   String

  status SteamMessageStatus @default(PENDING)
  error  String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@map("steam_messages")
}

enum SteamMessageStatus {
  PENDING
  SENT
  FAILED
}

/// Uma partida oficial de matchmaking, como o Game Coordinator do CS2 a
/// descreve para quem tem o share code: placar final, duração, e a linha de
/// scoreboard de cada um dos dez jogadores. É o que a Web API não dá —
/// por partida, não por total — e o que o csstats tem.
model Match {
  /// O matchid do GC (uint64), como string.
  id        String @id
  shareCode String @unique

  status     MatchStatus @default(PENDING)
  /// Quantas vezes o bot já pediu ao GC. Depois de algumas, desiste.
  tentativas Int         @default(0)
  error      String?

  jogadaEm DateTime?
  duracaoS Int?
  rounds   Int?
  /// Mapa lido do cabeçalho da demo (o GC não diz); reserva é o bot de
  /// presença de quem estava na partida.
  mapa     String?
  /// Nome do servidor da Valve, do mesmo cabeçalho ("south_america … gru1").
  servidor String?
  gameType Int?
  /// O modo da partida (premier, competitive, scrimcomp2v2…), resolvido na
  /// gravação: pelo `gameType` do GC quando o valor é conhecido, senão pelo
  /// rich presence de quem estava nela. É o eixo do submenu de modos.
  modo     String?
  placarA  Int?
  placarB  Int?
  demoUrl  String?
  /// A resposta do GC inteira (`CDataGCCStrike15_v2_MatchInfo`: um
  /// `roundstatsall` por round com kills/deaths/scores acumulados, pings,
  /// multi-kills, rankings da reserva). O GC esquece em ~30 dias; isto não.
  /// O que já virou coluna veio daqui; o resto espera a pergunta certa.
  gc       Json?

  /// Quem tinha a corrente de share codes que revelou esta partida. Os
  /// outros nove jogadores a ganham de graça.
  descobertaPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jogadores MatchPlayer[]
  demo      MatchDemo?
  metricas  MatchPlayerDemo[]
  conversao MatchTeamDemo[]

  @@index([status, createdAt])
  @@index([jogadaEm])
  @@index([modo])
  @@map("matches")
}

/// A demo da partida, reduzida pelo bot ao que as regras precisam
/// (`bot/src/demo-parse.ts`, docs/demos.md): rounds, mortes com posição,
/// dano, cegueiras, granadas, bomba, zona por onde cada um andou, rating.
/// Os eventos ficam inteiros para as métricas serem recalculadas quando a
/// regra mudar — a demo na CDN da Valve some em ~30 dias, isto aqui não.
model MatchDemo {
  matchId String @id
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  status     DemoStatus @default(PENDING)
  /// Quantas vezes o bot já tentou (download, descompressão ou parser).
  tentativas Int        @default(0)
  error      String?

  /// Versão do formato do payload e o parser que o produziu.
  versao Int?
  parser String?
  ticks  Int?
  /// O payload inteiro (jogadores, rounds, eventos, tiros).
  dados  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("match_demos")
}

enum DemoStatus {
  /// A partida tem URL de demo e o bot ainda não a leu.
  PENDING
  /// Eventos gravados e métricas calculadas.
  DONE
  /// A Valve já apagou a demo (404).
  EXPIRED
  /// Desistimos depois de várias tentativas.
  FAILED
}

/// As métricas de um jogador numa partida, calculadas dos eventos da demo
/// por `src/lib/demo/metricas.ts` — o que a Web API não dá (ADR, KAST,
/// aberturas, trocas, clutches, utilitário) e que as sessões vão ler em
/// série temporal. Recalculável: `versaoRegras` diz com qual regra.
model MatchPlayerDemo {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  steamId String

  versaoRegras Int
  /// Rounds em que o jogador esteve (quem saiu no meio conta só até sair).
  rounds       Int

  kills   Int
  deaths  Int
  assists Int
  hs      Int
  /// Dano causado a inimigos (limitado à vida que a vítima tinha) e sofrido.
  dano        Int
  danoSofrido Int
  adr         Float
  /// Fração dos rounds com kill, assist, sobrevivência ou morte trocada.
  kast        Float

  /// Primeira morte do round: quem matou abriu, quem morreu perdeu a abertura.
  aberturas         Int
  aberturasPerdidas Int
  /// Kill em até 5 s sobre quem acabou de matar um aliado; morte vingada nesse prazo.
  trocas         Int
  mortesTrocadas Int
  multi2 Int
  multi3 Int
  multi4 Int
  multi5 Int
  /// Vezes que ficou sozinho contra 1+ inimigos vivos, e quantas venceu.
  clutches       Int
  clutchesGanhos Int

  /// Inimigos e aliados cegados pelas flashes dele, e por quantos segundos os inimigos.
  inimigosCegados Int
  aliadosCegados  Int
  segundosCegando Float
  flashAssists    Int
  /// Dano de HE e molotov em inimigos; granadas lançadas (smoke, flash, HE, molotov, decoy).
  danoUtil Int
  granadas Int

  sobreviveu Int
  /// Segundos de vida depois do freeze, nos rounds em que morreu.
  vidaMediaS Float?
  /// Segundos em cada zona do mapa, por lado: `{ "CT": { "BombsiteA": 120 }, "T": {…} }`.
  zonas Json?
  /// ADR e kills pela compra do time no round (`src/lib/demo/economia.ts`):
  /// `{ "eco": { "rounds": 3, "kills": 1, "dano": 120 }, "cheia": {…} }`.
  /// Nulo em demo sem `round.economia` (payload v1).
  porCompra Json?

  /// O `rank_update` da demo: tipo 11 é o CS Rating do Premier.
  ratingTipo     Int?
  ratingAntes    Int?
  ratingDepois   Int?
  ratingMudanca  Int?
  ratingVitorias Int?

  @@unique([matchId, steamId])
  @@index([steamId])
  @@map("match_player_demos")
}

/// A conversão de um time numa partida, calculada dos mesmos eventos por
/// `src/lib/demo/conversao.ts`: o que ele fez com as vantagens que teve.
/// Uma linha por time (os dois), não por jogador — é a primeira métrica de
/// time da demo. Recalculável pelo mesmo `recompute:demos`.
model MatchTeamDemo {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// O lado em que o time começou a partida ("CT" ou "T"). É a identidade
  /// dele na demo, que não tem "time A" e "time B" e troca os lados no
  /// intervalo; a tela casa a linha com o time do placar pela escalação.
  ladoInicial String
  /// Os SteamIDs de quem jogou por este time em algum round.
  jogadores   Json

  versaoRegras Int
  rounds       Int
  roundsGanhos Int

  /// Rounds que começaram iguais em que o time, de CT, ficou com mais
  /// gente viva (com inimigo vivo) — e quantos virou round.
  vantagensCT       Int
  vantagensCTGanhas Int
  /// O mesmo, jogando de T.
  vantagensT       Int
  vantagensTGanhas Int

  /// Rounds em que o time, de T, plantou a bomba — e quantos venceu.
  plants       Int
  plantsGanhos Int

  /// Ritmo (docs/demos.md §4.2): mediana do segundo do primeiro contato
  /// nos rounds em que o time jogou de cada lado, contada do fim do
  /// freeze, com quantos rounds entraram na conta — round sem contato não
  /// entra. De T é o ritmo que o time impôs; de CT, o que sofreu.
  segundoContatoCT Float?
  contatosCT       Int    @default(0)
  segundoContatoT  Float?
  contatosT        Int    @default(0)
  /// Mediana do segundo da plantada nos rounds em que o time plantou; a
  /// base é `plants`.
  segundoPlant     Float?

  /// Economia (docs/demos.md §4.3): quantos rounds o time jogou em cada
  /// classe de compra, pela média do equipamento no fim do freeze, e
  /// quantos venceu. Nulo é "sem amostra" (demo lida em payload v1); zero
  /// é "nenhum round dessa classe".
  pistol       Int?
  pistolGanhos Int?
  eco          Int?
  ecoGanhos    Int?
  meia         Int?
  meiaGanhas   Int?
  cheia        Int?
  cheiaGanhas  Int?

  @@unique([matchId, ladoInicial])
  @@map("match_team_demos")
}

enum MatchStatus {
  /// Conhecemos o share code; o bot ainda não pediu ao GC.
  PENDING
  /// Scoreboard gravado.
  DONE
  /// O GC não tem mais a partida (guarda ~30 dias).
  EXPIRED
  /// Desistimos depois de várias tentativas.
  FAILED
}

/// A linha de um jogador no scoreboard de uma partida. Existe para os dez,
/// tenham conta aqui ou não: é o que permite comparar, ver amigos na mesma
/// partida e mostrar a página pública.
model MatchPlayer {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  steamId String
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// 0 = os cinco primeiros da reserva (placarA), 1 = os cinco últimos (placarB).
  time    Int
  kills   Int
  assists Int
  deaths  Int
  mvps    Int
  score   Int
  hs      Int
  /// Ping médio na partida, do último `roundstats` do GC. Só o GC tem isso.
  ping    Int?
  /// null em empate.
  venceu  Boolean?

  @@unique([matchId, steamId])
  @@index([steamId])
  @@index([userId])
  @@map("match_players")
}

/// Uma coleta que o bot pediu e ainda não deu certo.
///
/// O bot é um sensor: vê o fim da partida, avisa, e esquece. Quem lembra
/// é esta tabela — o contexto observado, quantas vezes já tentamos e
/// quando é a próxima. Reiniciar o bot não perde nada, e o cron pode
/// retomar o que a Steam demorou. Uma por pessoa: uma partida nova
/// substitui a anterior (o delta cobre as duas).
model PendingCapture {
  id String @id @default(cuid())

  /// Sem `@unique`: uma captura por partida observada, não uma por pessoa.
  /// Enquanto era única por usuário, o fim da segunda partida sobrescrevia
  /// a captura pendente da primeira — a coleta da primeira nunca
  /// acontecia e o ponto seguinte cobria as duas. Era assim que uma sessão
  /// aparecia com quatro ou cinco partidas dentro.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A observação que pediu esta captura. Única: o mesmo fim de partida,
  /// reenviado pelo bot depois de um reinício, não entra duas vezes na
  /// fila. Nula no histórico anterior a esta migração.
  observacaoId String? @unique

  steamId String

  matchMap   String?
  matchMode  String?
  matchScore String?
  traceId    String?

  tentativa Int      @default(0)
  proximaEm DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proximaEm])
  @@index([userId])
  @@map("pending_captures")
}

/// O bot conta como está a cada tick. Uma linha só.
model BotStatus {
  id           String    @id @default("bot")
  ultimoTickEm DateTime
  amigos       Int       @default(0)
  gcConectado  Boolean   @default(false)
  iniciadoEm   DateTime?
  /// O bot bate mesmo sem sessão na Steam: "parado" e "deslogado" são coisas diferentes.
  logado            Boolean   @default(true)
  desconectadoDesde DateTime?
  motivo            String?

  @@map("bot_status")
}

/// O que aconteceu de notável — erros e transições que o painel lista.
///
/// Não é analytics de clique: é o diário de operação. Um `catch` que só
/// escrevia no log da Vercel passa a deixar uma linha aqui, com quem e o
/// quê, para o painel mostrar sem ninguém abrir log.
model Evento {
  id String @id @default(cuid())

  nome    String
  userId  String?
  dados   Json?
  traceId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([nome, createdAt])
  @@map("eventos")
}

/// Uma sessão, materializada: o intervalo entre duas coletas em que os
/// rounds subiram, fechado no momento em que a segunda coleta é gravada.
///
/// Antes disso a sessão era recalculada a cada request sobre o balde de
/// snapshots, e o modo era o da coleta que fechava o intervalo — sem prova
/// de que o intervalo tinha uma partida só. Aqui os deltas são fatos
/// derivados uma vez, e o modo vem de `atribuirModo` (docs/dados-confiaveis.md
/// §3.2) com a confiança ao lado. `regraVersao` diz sob qual regra; mudou a
/// regra, `recompute:sessions` refaz.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameAppId  Int
  userGameId String

  deSnapshotId  String
  /// Uma sessão por coleta que a fecha: é a chave da idempotência.
  ateSnapshotId String @unique
  de            DateTime
  ate           DateTime

  /// Deltas do intervalo. `minutos` é o tempo EM PARTIDA quando a Steam dá
  /// `total_time_played`, senão o playtime.
  minutos   Int
  rounds    Int
  partidas  Int?
  vitorias  Int?
  kills     Int?
  deaths    Int?
  headshots Int?
  dano      Int?
  mvps      Int?

  /// Deltas por arma no intervalo: `{ "ak47": { "kills": 12, "tiros": 340, "acertos": 90 } }`.
  /// Só as armas que se moveram. Os contadores por arma da Steam somam todos
  /// os modos; é o intervalo desta sessão que os torna atribuíveis a um modo.
  armas Json?

  modo          String?
  modoConfianca ModoConfianca
  mapa          String?
  placar        String?
  /// As provas usadas: partidas do GC e observações do bot dentro do intervalo.
  matchIds      String[] @default([])
  observacaoIds String[] @default([])

  regraVersao Int
  traceId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, gameAppId, ate])
  @@index([userId, gameAppId, modo, modoConfianca])
  @@index([userGameId, ate])
  @@map("sessions")
}

enum ModoConfianca {
  /// Uma partida no intervalo e uma prova dela (GC ou bot).
  EXATA
  /// Várias partidas, todas provadas do mesmo modo — ou marca do bot antigo.
  INFERIDA
  /// Sem prova suficiente. Nunca entra numa aba nem num normal de modo.
  MISTA
}

/// Um insight materializado: uma regra determinística, versionada, sobre
/// uma sessão, um modo ou o período — com o valor, a referência contra a
/// qual foi lido, o delta julgado, a base e a confiança, e os dados do
/// visual que o desenha. A tela só lê (docs/dados-confiaveis.md §3.3).
///
/// A referência de uma sessão é o normal **na hora**: o acumulado das
/// sessões provadas do mesmo modo que vieram antes dela. Fica embutida
/// aqui, então a leitura de uma sessão antiga não muda quando entra sessão
/// nova — o que a regra leave-one-out da tela fazia.
model Insight {
  id String @id @default(cuid())

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameAppId Int

  escopo   InsightEscopo
  /// `SESSAO`: id da sessão; `MODO`/`PERIODO`: o modo (ou "tudo").
  escopoId String
  regra    String
  regraVersao Int
  /// sha256 das entradas serializadas: prova de reprodutibilidade.
  entradasHash String

  valor          Float?
  referencia     Float?
  /// vitalicio | modo | vitalicio-fraco | nenhum
  referenciaTipo String?
  delta          Float?
  deltaUnidade   String?
  tom            InsightTom
  confianca      ModoConfianca?
  /// { rounds, sessoes, partidas } — sobre o que o número se apoia.
  base   Json
  visual InsightVisual
  /// O que o visual precisa (pontos, ranking, progresso), pronto para desenhar.
  dados  Json
  /// A única linha de texto que a tela mostra.
  linha  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([escopo, escopoId, regra, regraVersao])
  @@index([userId, gameAppId, escopo, escopoId])
  @@map("insights")
}

enum InsightEscopo {
  SESSAO
  MODO
  PERIODO
}

enum InsightTom {
  BOM
  RUIM
  NEUTRO
  AVISO
}

enum InsightVisual {
  CHIP
  SELO
  BARRA
  SPARKLINE
  RANK
  ANEL
}

/// Um item do inventário de CS2 de um jogador, como fato com história:
/// `primeiraVezEm` quando apareceu, `ultimaVezEm` a última leitura em que
/// estava, `saiuEm` quando deixou de estar. Nada se apaga — o que entrou e
/// saiu é dado (docs/dados-confiaveis.md §2). Sem preço: é outra fonte.
model InventoryItem {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId        String
  classId        String
  amount         Int     @default(1)
  name           String
  marketHashName String?
  type           String?
  imageUrl       String?
  rarity         String?
  rarityKey      String?
  rarityColor    String?
  exterior       String?
  exteriorKey    String?
  weapon         String?
  category       String?
  stattrak       Boolean @default(false)
  souvenir       Boolean @default(false)
  tradable       Boolean @default(false)
  marketable     Boolean @default(false)

  primeiraVezEm DateTime  @default(now())
  ultimaVezEm   DateTime  @default(now())
  saiuEm        DateTime?

  @@unique([userId, assetId])
  @@index([userId, saiuEm])
  @@map("inventory_items")
}

/// O preço de um item no Mercado da Comunidade, por `market_hash_name`
/// (um só para todos os jogadores que o têm), em centavos de BRL, com a
/// data. `listado = false` quando o mercado não o vende. Renovado pelo
/// tick do bot, um item por vez, o mais velho primeiro.
model ItemPrice {
  marketHashName String   @id
  listado        Boolean  @default(true)
  menorCents     Int?
  medianaCents   Int?
  volume         Int?
  moeda          String   @default("BRL")
  atualizadoEm   DateTime @default(now())

  @@index([atualizadoEm])
  @@map("item_prices")
}

/// O que o bot de presença viu, antes de qualquer coleta.
///
/// A captura pendente some quando vira ponto; a observação fica. É o único
/// registro de "houve uma partida de Premier em Mirage às 22:02", e é o que
/// permite dar modo a uma sessão com prova, não por proximidade
/// (docs/dados-confiaveis.md §3.1–3.2).
/// O inventário público de quem não tem conta aqui, lido quando alguém
/// abre o perfil e guardado por 6 h (a Steam limita o endpoint por IP com
/// força). Só os itens, sem preço: a vitrine é o que a Steam já mostra a
/// qualquer um no perfil da pessoa. Quem tem conta usa `InventoryItem`.
model InventarioPublico {
  steamId String  @id
  publico Boolean
  total   Int     @default(0)
  /// Até 40 itens, do mais raro ao comum: nome, imagem, raridade, exterior, arma, categoria, selos.
  itens   Json
  lidoEm  DateTime

  @@map("inventarios_publicos")
}

/// Cada amigo do bot, tenha conta ou não. É o fato que `User.botAmigoDesde`
/// resume para quem entrou; para quem não entrou, é a única lista de quem
/// o bot alcança — e de quem já foi convidado, quantas vezes.
model BotAmigo {
  steamId String @id
  desde   DateTime @default(now())
  /// Preenchido quando some da lista; volta a nulo se re-adicionar.
  saiuEm  DateTime?
  /// Convites para entrar no FragIQ (só para quem não tem conta), com teto.
  convites        Int       @default(0)
  ultimoConviteEm DateTime?

  @@index([saiuEm])
  @@map("bot_amigos")
}

model BotObservation {
  id String @id @default(cuid())

  steamId String
  /// Nulo quando o bot é amigo de alguém que ainda não entrou no site.
  userId  String?

  kind       BotObservationKind
  map        String?
  mode       String?
  score      String?
  observedAt DateTime
  traceId    String

  createdAt DateTime @default(now())

  @@index([steamId, observedAt])
  @@index([userId, observedAt])
  @@index([traceId])
  @@map("bot_observations")
}

enum BotObservationKind {
  /// Rich presence perdeu o mapa: voltou ao lobby.
  MATCH_ENDED
  /// Fechou o CS2.
  LEFT_GAME
}

/// O log do bot, no banco, para o painel ler sem SSH.
///
/// O bot envia lotes (`POST /api/bot/logs`); a rota apaga o que tem mais
/// de 30 dias. Nível, mensagem e, quando o bot sabe, de quem e de qual
/// trace se trata.
model BotLog {
  id String @id @default(cuid())

  nivel    BotLogLevel
  mensagem String
  dados    Json?
  steamId  String?
  traceId  String?
  /// Quando o bot escreveu (o `createdAt` é quando chegou).
  em       DateTime

  createdAt DateTime @default(now())

  @@index([em])
  @@index([nivel, em])
  @@index([traceId])
  @@map("bot_logs")
}

enum BotLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}
