{
  "name": "fragiq-infra",
  "private": true,
  "description": "Infraestrutura do site do FragIQ na conta da Build Labs (CDK): Lambda + HTTP API com domínio na Cloudflare, agenda diária e migrações.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --quiet",
    "verificar": "npm run typecheck && npm test",
    "virada-dns": "tsx scripts/virada-dns.ts"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.1145.0",
    "@aws-sdk/client-cloudformation": "^3.1145.0",
    "@aws-sdk/client-lambda": "^3.1145.0",
    "@aws-sdk/client-ssm": "^3.1145.0",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "aws-cdk": "2.1143.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
